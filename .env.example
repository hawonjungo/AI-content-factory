# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Postgres (used by docker-compose) ---
POSTGRES_DB=aicontentfactory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_ORIGIN=http://localhost:5173

# --- AI providers (wired starting Phase 3 - Script/Storyboard/Prompt agents) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Budget / QA (Phase 4 + 6) ---
BUDGET_MONTHLY_LIMIT_USD=50
QA_MIN_SCORE=6.0

# --- Step 7: social publishing (TikTok / YouTube Shorts / Instagram Reels) ---
# Public HTTPS base URL of THIS API. Required for OAuth redirect URIs and for
# Instagram (Graph API pulls the video from a public URL). Leave blank locally -
# publishing UI still renders but OAuth cannot complete.
PUBLISHING_PUBLIC_BASE_URL=
# Where the OAuth callback sends the browser back to (the wizard). Blank = first CORS origin.
PUBLISHING_FRONTEND_RETURN_URL=
# Long random string - encrypts stored OAuth tokens at rest (AES-GCM).
PUBLISHING_TOKEN_ENCRYPTION_KEY=

# TikTok Content Posting API - https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube Data API v3 - Google Cloud OAuth client (scope youtube.upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram Reels - Meta app (scope instagram_content_publish)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Page - Meta app (scopes pages_show_list, pages_manage_posts, pages_read_engagement).
# Can be the SAME Meta app as Instagram (reuse INSTAGRAM_APP_ID / _SECRET here).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
